{
  "name": "dnd-campaign-map",
  "private": true,
  "description": "Campaign Chronicle — static site (no build step). These scripts are development tooling only.",
  "scripts": {
    "start": "npx serve -p 5500 .",
    "validate": "node tools/validate-data.js",
    "test": "node tools/validate-data.js && node --test tests/*.test.js",
    "test:browser": "node tests/browser/smoke.mjs && node tests/browser/taller.mjs",
    "test:taller": "node tests/browser/taller.mjs",
    "apply-draft": "node tools/apply-draft.js"
  },
  "devDependencies": {
    "playwright-core": "1.52.0"
  }
}
